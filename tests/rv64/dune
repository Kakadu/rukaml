(rule
 (target demo.s)
 (deps demo.ml)
 (mode
  (promote (until-clean)))
 (action
  (run %{project_root}/driver/driver.exe %{deps} --target rv64 -o %{target})))

(rule
 (target demo.anf.ml)
 (deps demo.ml)
 (mode
  (promote (until-clean)))
 (action
  (run %{project_root}/driver/driver.exe %{deps} --target anf -o %{target})))

(rule
 (targets demo.exe)
 (deps
  %{project_root}//driver/driver.exe
  (:src demo.s)
  (:stdlib %{project_root}/back/rv64/rukaml_stdlib.o))
 (mode
  (promote (until-clean)))
 (action
  (progn
   (run riscv64-linux-gnu-gcc-13 -g -c %{src} -o demo.o)
   (run riscv64-linux-gnu-gcc-13 -g %{stdlib} demo.o -o %{targets}))))

(cram
 (applies_to demo)
 (deps
  %{project_root}/back/rv64/rukaml_stdlib.o
  ./demo.exe
  demo.anf.ml
  demo.ml
  demo.s))
