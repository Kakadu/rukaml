(rule
 (target compiler.embox.s)
 (deps compiler.ml)
 (mode
  (promote (until-clean)))
 (action
  (progn
   (run
    %{project_root}/driver/driver.exe
    %{deps}
    --rename-main
    true
    --target
    rv32
    -o
    %{target}))))
