(library
 (name rv64_impl)
 (modules RV64_impl Machine)
 (wrapped false)
 (libraries cconv compile_lib)
 (instrumentation
  (backend bisect_ppx)))

(rule
 (target rukaml_stdlib.o)
 (enabled_if
  (not
   (= none %{read:../../cc_rv64})))
 (deps rukaml_stdlib.c)
 (action
  (system
   "grc %{read:../../cc_rv64} -march=rv64g -c %{deps} -Wno-pedantic -ffreestanding  -nostdlib -std=c99 -ggdb -o %{target}")))
