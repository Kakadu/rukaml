(copy_files ../../back/llvm/rukaml_stdlib.c)

(rule
 (targets llvm_cflags.sexp llvm_ldflags.sexp)
 (action
  (progn
   (with-stdout-to
    llvm_cflags.sexp
    (run sh -c "echo \"(-I$(llvm-config-19 --includedir))\""))
   (with-stdout-to
    llvm_ldflags.sexp
    (run sh -c "echo \"(-L$(llvm-config-19 --libdir) -lLLVM-19)\"")))))

(library
 (name JIT_orc_lib)
 (libraries IR JIT_engine_lib)
 (foreign_stubs
  (language c)
  (names rukaml_stdlib))
 (foreign_stubs
  (language cxx)
  (names rukaml_orc_jit rukaml_orc_jit_bindings)
  (extra_deps rukaml_orc_jit.hpp)
  (flags
   :standard
   -std=c++17
   -fno-rtti
   (:include llvm_cflags.sexp)
   -D__STDC_CONSTANT_MACROS
   -D__STDC_FORMAT_MACROS
   -D__STDC_LIMIT_MACROS))
 (c_library_flags
  (-lstdc++ (:include llvm_ldflags.sexp)))
 (instrumentation
  (backend bisect_ppx)))
