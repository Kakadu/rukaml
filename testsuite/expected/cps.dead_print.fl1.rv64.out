
.text

.globl __lifted_lam_1
__lifted_lam_1:
  addi sp, sp, -16
  sd zero, (sp) # loc for temp5
  sd ra, 8(sp)
  ld t0, 16(sp)
  li t1, 0
# going to do some arithmetic
  add  t2, t0, t1
  sd t2, (sp)
  ld t5, (sp)
  addi a2, t5, 0
  ld a0, 24(sp)
  li a1, 1
  call rukaml_applyN
  ld ra, 8(sp)
  addi sp, sp, 16 # DEallocate for RA, and 1 locals temp5
  ret # __lifted_lam_1

.globl f
f:
  addi sp, sp, -16
  sd zero, (sp) # loc for temp7
  sd ra, 8(sp)
  ld a0, 16(sp)
  call rukaml_print_int
  sd zero, (sp)
  lla a0, __lifted_lam_1
  li a1, 2
  call rukaml_alloc_closure
  mv a2, a0
  ld a0, 24(sp)
  li a1, 1
  call rukaml_applyN
  ld ra, 8(sp)
  addi sp, sp, 16 # DEallocate for RA, and 1 locals temp7
  ret # f

.globl __lifted_lam_3
__lifted_lam_3:
  addi sp, sp, -16
  sd ra, (sp)
  sd zero, 8(sp) # padding
  li a0, 0
  ld ra, (sp)
  addi sp, sp, 16 # DEallocate for Pad, RA and 0 locals variables 
  ret # __lifted_lam_3

.globl __lifted_lam_2
__lifted_lam_2:
  addi sp, sp, -16
  sd ra, (sp)
  sd zero, 8(sp) # padding
# Allocate args to call fun "f" with args
  addi sp, sp, -16 # last_pos = 4
  li t0, 1
  sd t0, (sp) # constant
  lla a0, __lifted_lam_3
  li a1, 1
  call rukaml_alloc_closure
  sd a0, 8(sp)
  call f
  addi sp, sp, 16 # deallocate 2 args
  mv a0, a0
  ld ra, (sp)
  addi sp, sp, 16 # DEallocate for Pad, RA and 0 locals variables 
  ret # __lifted_lam_2

.globl main
main:
  mv a0, sp
  call rukaml_initialize
# this is main
  li a0, 0
  addi sp, sp, -16
  sd ra, (sp)
  sd zero, 8(sp) # padding
# Allocate args to call fun "f" with args
  addi sp, sp, -16 # last_pos = 4
  li t0, 1
  sd t0, (sp) # constant
  lla a0, __lifted_lam_2
  li a1, 1
  call rukaml_alloc_closure
  sd a0, 8(sp)
  call f
  addi sp, sp, 16 # deallocate 2 args
  mv a0, a0
  ld ra, (sp)
  addi sp, sp, 16 # DEallocate for Pad, RA and 0 locals variables 
#  fin
  addi a0, x0, 0 # Use 0 return code
  addi a7, x0, 93 # Service command code 93 terminates
  ecall # Call linux to terminate the program
