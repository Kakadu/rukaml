
.globl fresh_1
fresh_1:
  addi sp, sp, -16 # allocate for RA, and 1 locals temp5
  sd ra, 8(sp)
  ld t0, 16(sp)
  li t1, 0
  add  t2, t0, t1
  sd t2, (sp)
  addi sp, sp, -16 # pad and 1st arg of function k2
  ld t5, 16(sp)
  sd t5, (sp) # access a var "temp5"
  ld a0, 40(sp)
  li a1, 1
  ld a2, (sp)
  call rukaml_applyN
  addi sp, sp, 16 # DEalloc for pad and arg 1 of function "k2"
  ld ra, 8(sp)
  addi sp, sp, 16 # DEallocate for RA, and 1 locals temp5
  ret # fresh_1

.globl f
f:
  addi sp, sp, -16 # allocate for RA, and 1 locals y
  sd ra, 8(sp)
  addi sp, sp, -16
  sd ra, 8(sp)
  ld t0, 32(sp)
  sd t0, (sp)
  call rukaml_print_int
  ld ra, 8(sp)
  sd a0, 16(sp)
  addi sp, sp, 16
  addi sp, sp, -16 # pad and 1st arg of function k1
  lla a0, fresh_1
  li a1, 2
  call rukaml_alloc_closure
  sd a0, (sp)
  ld a0, 40(sp)
  li a1, 1
  ld a2, (sp)
  call rukaml_applyN
  addi sp, sp, 16 # DEalloc for pad and arg 1 of function "k1"
  ld ra, 8(sp)
  addi sp, sp, 16 # DEallocate for RA, and 1 locals y
  ret # f

.globl fresh_3
fresh_3:
  addi sp, sp, -16 # allocate for RA, and 1 locals y
  sd ra, 8(sp)
  ld t5, 16(sp)
  sd t5, (sp) # access a var "t4"
  li a0, 0
  ld ra, 8(sp)
  addi sp, sp, 16 # DEallocate for RA, and 1 locals y
  ret # fresh_3

.globl fresh_2
fresh_2:
  addi sp, sp, -16 # allocate for RA, and 1 locals x
  sd ra, 8(sp)
  ld t5, 16(sp)
  sd t5, (sp) # access a var "t3"
# Allocate args to call fun "f" with args
  addi sp, sp, -16 # last_pos = 4
  li t0, 1
  sd t0, (sp) # constant
  lla a0, fresh_3
  li a1, 1
  call rukaml_alloc_closure
  sd a0, 8(sp)
  call f
  addi sp, sp, 16 # deallocate 2 args
  mv a0, a0
  ld ra, 8(sp)
  addi sp, sp, 16 # DEallocate for RA, and 1 locals x
  ret # fresh_2

.globl main
main:
  mv a0, sp
  call rukaml_initialize
# this is main
  addi sp, sp, -16 # allocate for Pad, RA, and 0 locals 
  sd ra, (sp)
# Allocate args to call fun "f" with args
  addi sp, sp, -16 # last_pos = 4
  li t0, 1
  sd t0, (sp) # constant
  lla a0, fresh_2
  li a1, 1
  call rukaml_alloc_closure
  sd a0, 8(sp)
  call f
  addi sp, sp, 16 # deallocate 2 args
  mv a0, a0
  ld ra, (sp)
  addi sp, sp, 16 # DEallocate for Pad, RA and 0 locals variables 
#  fin
  addi a0, x0, 0 # Use 0 return code
  addi a7, x0, 93 # Service command code 93 terminates
  ecall # Call linux to terminate the program
