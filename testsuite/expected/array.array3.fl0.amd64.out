section .note.GNU-stack noalloc noexec nowrite progbits
section .text
extern add_gc_static_root
extern rukaml_alloc_closure
extern rukaml_print_int
extern rukaml_print_int_kaml
extern rukaml_applyN
extern rukaml_field
extern rukaml_tag
extern rukaml_size
extern rukaml_alloc_pair
extern rukaml_alloc_block
extern rukaml_array_stdin
extern rukaml_array_set
extern rukaml_array_read_in
extern rukaml_block_size
extern rukaml_block_tag
extern rukaml_block_nth
extern rukaml_match_failure
extern rukaml_initialize
extern rukaml_gc_compact
extern rukaml_gc_print_stats
extern rukaml_print_alloc_closure_count
extern rukaml_alloc_printf_closure
extern rukaml_alloc_fprintf_closure
extern rukaml_alloc_sprintf_closure
extern rukaml_stdout
extern rukaml_equal_struct
extern rukaml_string_of_char_list
extern rukaml_string_equal
extern rukaml_string_nth
extern rukaml_string_len
extern rukaml_apply1
extern rukaml_apply2
extern rukaml_stdin
extern rukaml_stdout
extern rukaml_stderr
