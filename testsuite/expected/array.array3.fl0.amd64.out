extern rukaml_open_out
extern rukaml_close_channel
extern rukaml_end_of_input
extern rukaml_input_char
extern rukaml_argv

section .bss
  rukaml_discard: resq 1


        section .text
        _start:
              push    rbp
              mov     rbp, rsp   ; prologue
              call main
              mov rdi, rax    ; rdi stores return code
              mov rax, 60     ; exit syscall
              syscall
section .text
rukaml_init_global_immediates:
  push rbp
  mov rbp, rsp
  pop rbp
  ret ;;; rukaml_init_global_immediates
section .text
GLOBAL main

main:
  push rbp
  mov  rbp, rsp
  push rdi          ; save argc
  push rsi          ; save argv
  mov rdi, rbp      ; ebp  (for gc initialization)
  mov rsi, [rsp+8]  ; argc (for Sys.argv initialization)
  mov rdx, [rsp]    ; argv (for Sys.argv initialization)
  call rukaml_initialize
  call rukaml_init_global_immediates
  pop rsi           ; pass argv to main
  pop rdi           ; pass argc to main
  sub rsp, 8*4 ; allocate for local variables temp4, temp3, temp2, temp1
  mov rdi, 4 ; array size
  mov rsi, 1 ; array tag
  call rukaml_alloc_block
  add rsp, -8*2 ; push array
  mov qword [rsp], rax
  mov qword rsi,  48
  mov qword rdi, [rsp] ; get array
  mov qword [rdi+8*0], rsi ; set field of array
  mov qword rsi,  49
  mov qword rdi, [rsp] ; get array
  mov qword [rdi+8*1], rsi ; set field of array
  mov qword rsi,  50
  mov qword rdi, [rsp] ; get array
  mov qword [rdi+8*2], rsi ; set field of array
  mov qword rsi,  51
  mov qword rdi, [rsp] ; get array
  mov qword [rdi+8*3], rsi ; set field of array
  mov rax, [rsp]
  add rsp, 8*2 ; pop array
  mov [rbp-1*8], rax
  mov rdi, rukaml_block_nth
  mov rsi, 2
  call rukaml_alloc_closure
  mov rdi, rax
  mov rsi, 1
  mov rdx, [rbp-1*8]
  mov rax, 0
  call rukaml_applyN
  mov [rbp-2*8], rax
  sub rsp, 8 ; padding
  sub rsp, 8 ; first arg of a function temp2
  mov qword [rbp-6*8],  0
  mov rax, 0  ; no float arguments
  mov rdi, [rbp-2*8]
  mov rsi, 1
  mov rdx, [rbp-6*8]
  call rukaml_applyN
  add rsp, 8*2 ; free space for args of function "temp2"
  mov [rbp-3*8], rax
  mov r11, [rbp-3*8]
  mov [rbp-4*8], r11
  mov rdi, [rbp-4*8]
  call rukaml_print_int
  mov rax, rax
  add rsp, 8*4 ; deallocate local variables temp4, temp3, temp2, temp1
  pop rbp
  ret  ;;;; main
