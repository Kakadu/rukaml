section .bss
  rukaml_discard: resq 1


        section .text
        _start:
              push    rbp
              mov     rbp, rsp   ; prologue
              call main
              mov rdi, rax    ; rdi stores return code
              mov rax, 60     ; exit syscall
              syscall
section .text
GLOBAL large_id71

large_id71:
  push rbp
  mov  rbp, rsp
  mov qword rdx, [rbp+2*8]
  cmp rdx, 0
  je lab_then_9
  mov rdi, 0
  call rukaml_print_int
  mov qword rax, 0
  jmp lab_endif_10
lab_then_9:
  mov rdi, 1
  call rukaml_print_int
  mov qword rax, 0
lab_endif_10:
  pop rbp
  ret  ;;;; large_id71
section .text
rukaml_init_global_immediates:
  push rbp
  mov rbp, rsp
  pop rbp
  ret ;;; rukaml_init_global_immediates
section .text
GLOBAL main

main:
  push rbp
  mov  rbp, rsp
  push rdi          ; save argc
  push rsi          ; save argv
  mov rdi, rbp      ; ebp  (for gc initialization)
  mov rsi, [rsp+8]  ; argc (for Sys.argv initialization)
  mov rdx, [rsp]    ; argv (for Sys.argv initialization)
  call rukaml_initialize
  call rukaml_init_global_immediates
  pop rsi           ; pass argv to main
  pop rdi           ; pass argc to main
  sub rsp, 8*4 ; allocate for local variables temp6, temp5, temp8, temp4
  mov rdi, 42
  call rukaml_print_int
  mov qword [rbp-2*8], 0
  mov qword [rbp-1*8],  1
  mov qword rdx, [rbp-1*8]
  cmp rdx, 0
  je lab_then_11
  mov qword [rbp-3*8], 0
  jmp lab_endif_12
lab_then_11:
  mov qword [rbp-3*8], 1
lab_endif_12:
  mov qword rdx, [rbp-3*8]
  cmp rdx, 0
  je lab_then_13
  mov qword [rbp-4*8], 0
  jmp lab_endif_14
lab_then_13:
  mov qword [rbp-4*8], 1
lab_endif_14:
  sub rsp, 8 ; trying to save alignment 16 bytes
  sub rsp, 8*1 ; fun arguments
  mov qword r8, [rbp-4*8]  ; arg "temp6"
  mov qword [rsp+0*8], r8
  call large_id71
  add rsp, 8*2 ; dealloc args
  mov rax, rax
  add rsp, 8*4 ; deallocate local variables temp6, temp5, temp8, temp4
  pop rbp
  ret  ;;;; main
