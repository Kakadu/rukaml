; ModuleID = 'main'
source_filename = "main"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

declare void @myputc(i64)

declare i64 @rukaml_applyN(i64, i64, ...)

declare i64 @rukaml_alloc_closure(i64, i64)

declare i64 @rukaml_alloc_pair(i64, i64)

declare i64 @rukaml_alloc_array(i64, i64)

declare i64 @rukaml_array_length(i64)

declare i64 @rukaml_field(i64, i64)

define i64 @main() {
entry:
  %0 = alloca [2 x i64], align 8
  store [2 x i64] [i64 1, i64 2], ptr %0, align 8
  %1 = ptrtoint ptr %0 to i64
  %2 = call i64 @rukaml_alloc_array(i64 %1, i64 2)
  ret i64 0
}
