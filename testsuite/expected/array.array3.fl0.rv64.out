
.text

.globl main
main:
  mv a0, sp
  call rukaml_initialize
# this is main
  li a0, 0
  addi sp, sp, -32
  sd zero, (sp) # loc for temp4
  sd zero, 8(sp) # loc for temp3
  sd zero, 16(sp) # loc for temp1
  sd ra, 24(sp)
  addi sp, sp, -16
  sd ra, 8(sp)
  li a0, 4
  call rukaml_alloc_array
  sd a0, (sp)
  li t0, 48
  ld t1, (sp)
  sd t0, (t1)
  li t0, 49
  ld t1, (sp)
  sd t0, 8(t1)
  li t0, 50
  ld t1, (sp)
  sd t0, 16(t1)
  li t0, 51
  ld t1, (sp)
  sd t0, 24(t1)
  ld ra, 8(sp)
  ld t0, (sp)
  sd t0, 32(sp)
  addi sp, sp, 16
  addi sp, sp, -16
  sd ra, (sp)
  lla a0, rukaml_array_get
  li a1, 2
  call rukaml_alloc_closure
  li a1, 2
  ld a2, 32(sp)
  li a3, 0
  call rukaml_applyN
  sd a0, 24(sp)
  ld ra, (sp)
  addi sp, sp, 16
  ld t0, 8(sp)
  sd t0, (sp)
  ld a0, (sp)
  call rukaml_print_int
  mv a0, zero
  ld ra, 24(sp)
  addi sp, sp, 32 # DEallocate for RA, and 3 locals temp4, temp3, temp1
#  fin
  addi a0, x0, 0 # Use 0 return code
  addi a7, x0, 93 # Service command code 93 terminates
  ecall # Call linux to terminate the program
