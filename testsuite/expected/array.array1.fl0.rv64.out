
.text
.globl rukaml_init_global_immediates
rukaml_init_global_immediates:
  addi sp, sp, -16
  sd ra, (sp)
  ld ra, (sp)
  addi sp, sp, 16
  ret # fin rukaml_init_global_immediates

.text
.globl rukaml_initilize_string_constants
rukaml_initilize_string_constants:
  addi sp, sp, -32
  sd ra, (sp)
  ld ra, (sp)
  addi sp, sp, 32
  ret

.text
.globl main
main:
  mv a2, a1 # argv
  mv a1, a0 # argc
  mv a0, sp # Stack pointer is first
  call rukaml_initialize
  call rukaml_initilize_string_constants
  call rukaml_init_global_immediates
# this is main
  li a0, 0
  addi sp, sp, -32
  sd zero, (sp) # loc for temp4
  sd zero, 8(sp) # loc for temp2
  sd zero, 16(sp) # loc for temp1
  sd ra, 24(sp)
  addi sp, sp, -16
  sd ra, 8(sp)
  li a0, 4
  call rukaml_alloc_array
  sd a0, (sp)
  li t0, 1
  ld t1, (sp)
  sd t0, (t1)
  li t0, 4
  ld t1, (sp)
  sd t0, 8(t1)
  li t0, 3
  ld t1, (sp)
  sd t0, 16(t1)
  li t0, 3
  ld t1, (sp)
  sd t0, 24(t1)
  ld ra, 8(sp)
  ld t0, (sp)
  sd t0, 32(sp)
  addi sp, sp, 16
  addi sp, sp, -32
  sd ra, 24(sp)
  ld t0, 48(sp)
  addi a0, t0, 0
  li a1, 1
  li a2, 42
  call rukaml_array_set_sysv
  ld ra, 24(sp)
  addi sp, sp, 32
  sd a0, 8(sp)
  ld t0, 16(sp)
  addi a0, t0, 0
  li a1, 1
  call rukaml_array_get_sysv
  sd a0, (sp)
  ld a0, (sp)
  call rukaml_print_int
  mv a0, zero
  ld ra, 24(sp)
  addi sp, sp, 32 # Deallocate for Pad, RA and 3 locals variables temp4, temp2, temp1
#  fin
  addi a0, x0, 0 # Use 0 return code
  addi a7, x0, 93 # Service command code 93 terminates
  ecall # Call linux to terminate the program
