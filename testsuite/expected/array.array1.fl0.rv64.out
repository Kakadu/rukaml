
.globl main
main:
  mv a0, sp
  call rukaml_initialize
# this is main
  li a0, 0
  addi sp, sp, -32 # allocate for RA, and 3 locals temp6, unit, r
  sd ra, 24(sp)
  addi sp, sp, -16
  sd ra, 8(sp)
  li a0, 4
  call rukaml_alloc_array
  sd a0, (sp)
  li t0, 1
  ld t1, (sp)
  sd t0, (t1)
  li t0, 4
  ld t1, (sp)
  sd t0, 8(t1)
  li t0, 3
  ld t1, (sp)
  sd t0, 16(t1)
  li t0, 3
  ld t1, (sp)
  sd t0, 24(t1)
  ld ra, 8(sp)
  ld t0, (sp)
  sd t0, 32(sp)
  addi sp, sp, 16
  addi sp, sp, -32
  sd ra, 24(sp)
  ld a0, 48(sp)
  sd a0, (sp)
  li a0, 1
  sd a0, 8(sp)
  li t0, 42
  sd t0, 16(sp)
  call rukaml_array_set
  ld ra, 24(sp)
  addi sp, sp, 32
  sd a0, 8(sp)
  addi sp, sp, -16
  sd ra, (sp)
  lla a0, rukaml_array_get
  li a1, 2
  call rukaml_alloc_closure
  li a1, 2
  ld a2, 32(sp)
  li a3, 1
  call rukaml_applyN
  sd a0, 16(sp)
  ld ra, (sp)
  addi sp, sp, 16
  ld a0, (sp)
  call rukaml_print_int
  mv a0, zero
  ld ra, 24(sp)
  addi sp, sp, 32 # DEallocate for RA, and 3 locals temp6, unit, r
#  fin
  addi a0, x0, 0 # Use 0 return code
  addi a7, x0, 93 # Service command code 93 terminates
  ecall # Call linux to terminate the program
