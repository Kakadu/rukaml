
.text
.globl rukaml_init_global_immediates
rukaml_init_global_immediates:
  addi sp, sp, -16
  sd ra, (sp)
  ld ra, (sp)
  addi sp, sp, 16
  ret

.text
.globl main
main:
  mv a0, sp
  call rukaml_initialize
  call rukaml_init_global_immediates
# this is main
  li a0, 0
  addi sp, sp, -32
  sd zero, (sp) # loc for temp2
  sd zero, 8(sp) # loc for temp1
  sd ra, 16(sp)
  sd zero, 24(sp) # padding
  addi sp, sp, -16
  sd ra, 8(sp)
  li a0, 3
  call rukaml_alloc_array
  sd a0, (sp)
  li t0, 1
  ld t1, (sp)
  sd t0, (t1)
  li t0, 2
  ld t1, (sp)
  sd t0, 8(t1)
  li t0, 3
  ld t1, (sp)
  sd t0, 16(t1)
  ld ra, 8(sp)
  ld t0, (sp)
  sd t0, 24(sp)
  addi sp, sp, 16
  addi sp, sp, -16
  sd ra, 8(sp)
  ld t0, 24(sp)
  sd t0, (sp)
  call rukaml_array_length
  ld ra, 8(sp)
  sd a0, 16(sp)
  addi sp, sp, 16
  ld a0, (sp)
  call rukaml_print_int
  mv a0, zero
  ld ra, 16(sp)
  addi sp, sp, 32 # DEallocate for Pad, RA and 2 locals variables temp2, temp1
#  fin
  addi a0, x0, 0 # Use 0 return code
  addi a7, x0, 93 # Service command code 93 terminates
  ecall # Call linux to terminate the program
