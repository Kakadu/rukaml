
.text
.globl __lifted_lam_1
__lifted_lam_1:
  addi sp, sp, -16
  sd ra, (sp)
  sd zero, 8(sp) # padding
  ld t0, 16(sp)
  li t1, 0
# going to do some arithmetic
  add  t2, t0, t1
  mv a0, t2
  ld ra, (sp)
  addi sp, sp, 16 # DEallocate for Pad, RA and 0 locals variables 
  ret # __lifted_lam_1

.text
.globl f
f:
  addi sp, sp, -16
  sd zero, (sp) # loc for temp2
  sd ra, 8(sp)
  ld a0, 16(sp)
  call rukaml_print_int
  sd zero, (sp)
  lla a0, __lifted_lam_1
  li a1, 1
  call rukaml_alloc_closure
  mv a0, a0
  ld ra, 8(sp)
  addi sp, sp, 16 # DEallocate for RA, and 1 locals temp2
  ret # f

.text
.globl rukaml_init_global_immediates
rukaml_init_global_immediates:
  addi sp, sp, -16
  sd ra, (sp)
  ld ra, (sp)
  addi sp, sp, 16
  ret

.text
.globl main
main:
  mv a0, sp
  call rukaml_initialize
  call rukaml_init_global_immediates
# this is main
  li a0, 0
  addi sp, sp, -32
  sd zero, (sp) # loc for temp4
  sd zero, 8(sp) # loc for temp3
  sd ra, 16(sp)
  sd zero, 24(sp) # padding
# HERR: use new Toplevel module
# Allocate args to call fun "f" with args
  addi sp, sp, -16 # last_pos = 6
  li t0, 1
  sd t0, (sp) # constant
  call f
  addi sp, sp, 16 # deallocate 1 args
  sd a0, 8(sp)
# HERR: use new Toplevel module
# Allocate args to call fun "f" with args
  addi sp, sp, -16 # last_pos = 6
  li t0, 1
  sd t0, (sp) # constant
  call f
  addi sp, sp, 16 # deallocate 1 args
  sd a0, (sp)
  li a0, 0
  ld ra, 16(sp)
  addi sp, sp, 32 # DEallocate for Pad, RA and 2 locals variables temp4, temp3
#  fin
  addi a0, x0, 0 # Use 0 return code
  addi a7, x0, 93 # Service command code 93 terminates
  ecall # Call linux to terminate the program
