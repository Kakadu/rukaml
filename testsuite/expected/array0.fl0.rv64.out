
.globl main
main:
  mv a0, sp
  call rukaml_initialize
# this is main
  addi sp, sp, -32 # allocate for Pad, RA, and 2 locals n, r
  sd ra, 16(sp)
  addi sp, sp, -32
  li t0, 1
  sd t0, (sp)
  li t0, 2
  sd t0, 8(sp)
  li t0, 3
  sd t0, 16(sp)
  li a0, 3
  mv a1, sp
  call rukaml_alloc_array
  addi sp, sp, 32
  sd a0, 8(sp)
  addi sp, sp, -16
  sd ra, 8(sp)
  ld t0, 24(sp)
  sd t0, (sp)
  call rukaml_array_length
  ld ra, 8(sp)
  sd a0, 16(sp)
  addi sp, sp, 16
  addi sp, sp, -16
  sd ra, 8(sp)
  ld t0, 16(sp)
  sd t0, (sp)
  call rukaml_print_int
  ld ra, 8(sp)
  mv a0, a0
  addi sp, sp, 16
  ld ra, 16(sp)
  addi sp, sp, 32 # DEallocate for Pad, RA and 2 locals variables n, r
#  fin
  addi a0, x0, 0 # Use 0 return code
  addi a7, x0, 93 # Service command code 93 terminates
  ecall # Call linux to terminate the program
