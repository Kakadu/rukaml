let rec __lifted_let_1_helper s len n =
  let temp1 = (n >= len) in
  (if temp1
  then Constr_0
  else let temp4 = string_nth s n in
       let temp7 = (n + 1) in
       let temp8 = __lifted_let_1_helper s len temp7 in
       (Constr_1 (temp4, temp8)))
let string_to_char_list s =
